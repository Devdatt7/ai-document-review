# Copy to .env and fill in. Never commit .env.
# Free key: https://aistudio.google.com/apikey
# Use SYNTHETIC documents only: free-tier data may be used by Google.
GEMINI_API_KEY=your_key_here
# Backup provider, used only when Gemini hits its limit (https://console.x.ai).
# XAI_API_KEY=your_xai_key_here
# XAI_MODEL=grok-3-mini
# Optional: several keys separated by commas. If one hits its limit, the next is used.
# GEMINI_API_KEYS=key_one,key_two,key_three
GEMINI_MODEL=gemini-3.7-flash
# Used when the main model's quota is exhausted on every key (comma separated).
GEMINI_FALLBACK_MODELS=gemini-3.7-flash-lite
