# Copy to .env and fill in. Never commit .env.
# Free key: https://aistudio.google.com/apikey
# Use SYNTHETIC documents only: free-tier data may be used by Google.
GEMINI_API_KEY=your_key_here
# Comma-separated frontend origins (no trailing slash or URL fragment).
CORS_ORIGINS=https://ai-document-review-two-blond.vercel.app
# Optional free backup after Gemini, before paid providers.
# Get a key at https://openrouter.ai/settings/keys. Free requests have usage limits.
# OPENROUTER_API_KEY=your_openrouter_key_here
# Only openrouter/free or model IDs ending in :free are allowed.
# OPENROUTER_MODEL=openrouter/free
# Backup provider, used only when Gemini hits its limit (https://console.x.ai).
# XAI_API_KEY=your_xai_key_here
# XAI_MODEL=grok-3-mini
# Optional backup after Gemini and xAI limits (https://platform.openai.com/api-keys).
# OpenAI usage may incur charges. Keep this key only in the backend environment.
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_MODEL=gpt-4o-mini
# Optional final backup: Anthropic Claude. Usage may incur charges.
# Keep this key only in the backend environment.
# ANTHROPIC_API_KEY=your_anthropic_key_here
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Optional: several keys separated by commas. If one hits its limit, the next is used.
# GEMINI_API_KEYS=key_one,key_two,key_three
GEMINI_MODEL=gemini-3.7-flash
# Used when the main model's quota is exhausted on every key (comma separated).
GEMINI_FALLBACK_MODELS=gemini-3.7-flash-lite
