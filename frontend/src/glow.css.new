/* Black-and-white glow theme. Loaded after styles.css and overrides its colours. */
:root {
  color-scheme: dark;
  --ink: #f4f4f4;
  --muted: #a3a3a3;
  --line: #2b2b2b;
  --paper: #111;
  --canvas: #050505;
  --accent: #fff;
  --accent-dark: #d9d9d9;
  --critical: #ff6b6b;
  --high: #ff9a5c;
  --medium: #f0c05a;
  --low: #b5b5b5;
  --ready: #7bd3a4;
  --review: #f0c05a;
  --blocked: #ff6b6b;
  --glow: 255 255 255;
  --glass: rgb(20 20 20 / .72);
  --glass-border: rgb(255 255 255 / .14);
  --glow-shadow: 0 0 0 1px rgb(255 255 255 / .05), 0 10px 30px -12px rgb(255 255 255 / .18);
}

html, body {
  color: var(--ink);
  background:
    radial-gradient(800px 480px at 8% -8%, rgb(var(--glow) / .14), transparent 60%),
    radial-gradient(700px 440px at 100% 4%, rgb(var(--glow) / .09), transparent 60%),
    radial-gradient(700px 520px at 50% 108%, rgb(var(--glow) / .08), transparent 60%),
    #050505;
  background-attachment: fixed;
}

/* Common surfaces */
.app-header {
  position: sticky;
  top: 0;
  z-index: 20;
  padding: 0 14px;
  margin-top: 10px;
  border: 1px solid var(--glass-border);
  border-radius: 14px;
  background: var(--glass);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  box-shadow: var(--glow-shadow);
}
.brand-mark { background: #fff; color: #000; box-shadow: 0 0 16px rgb(255 255 255 / .55); }

.intro, .hero-preview, .auth-card, .input-panel, .sample-card, .landing-features article,
.intro-steps li, .account-chip, .queue-panel, .detail-panel, .document-context, .summary-top,
.sample-notice, .panel, .card {
  background: var(--glass);
  color: var(--ink);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-color: var(--glass-border);
  box-shadow: var(--glow-shadow);
}
.queue-panel, .detail-panel, .document-context, .summary-top { border-radius: 10px; overflow: hidden; }
.sample-card.good, .sample-card.risky { background: var(--glass); }
.sample-card.good { border-top-color: #fff; }
.sample-card.risky { border-top-color: #8a8a8a; }
.intro { background: linear-gradient(135deg, rgb(255 255 255 / .09), rgb(255 255 255 / .02)); }
.intro p, .landing-hero p, .action-disclaimer, .footer { color: var(--muted); }
.footer { border-top-color: var(--line); }

.doc { background: #0b0b0b; border-color: var(--line); }
.sentence { color: #d6d6d6; border-bottom-color: #1e1e1e; }
.sentence:hover { background: #1a1a1a; }
.sentence .sid { color: #7d7d7d; }
.sentence.hl.CRITICAL { background: rgb(255 107 107 / .14); }
.sentence.hl.HIGH { background: rgb(255 154 92 / .14); }
.sentence.hl.MEDIUM { background: rgb(240 192 90 / .14); }
.sentence.hl.LOW { background: rgb(255 255 255 / .07); }

input, textarea, select {
  background: #0b0b0b;
  color: var(--ink);
  border-color: #333;
}
input::placeholder, textarea::placeholder { color: #707070; }

/* Buttons: white on black */
.primary-button, .nav-link.primary {
  background: #fff;
  color: #000;
  border-radius: 8px;
  box-shadow: 0 0 18px rgb(255 255 255 / .35);
  transition: box-shadow .2s ease, transform .2s ease;
}
.primary-button:hover:not(:disabled), .nav-link.primary:hover {
  background: #fff;
  box-shadow: 0 0 28px rgb(255 255 255 / .7);
  transform: translateY(-1px);
}
.primary-button:active:not(:disabled) { transform: translateY(0); }
.primary-button:disabled { background: #3a3a3a; color: #888; box-shadow: none; }
.secondary-button {
  background: transparent;
  color: var(--ink);
  border: 1px solid #444;
  border-radius: 8px;
  transition: box-shadow .2s ease, border-color .2s ease;
}
.secondary-button:hover:not(:disabled) { border-color: #fff; background: rgb(255 255 255 / .06); box-shadow: 0 0 16px rgb(255 255 255 / .25); }
.nav-link { color: var(--ink); }
.landing-final .primary-button { background: #fff; color: #000; }

/* Glow on interaction */
.sample-card:hover, .landing-features article:hover {
  border-color: #fff;
  box-shadow: 0 0 28px rgb(255 255 255 / .25), 0 14px 30px -16px rgb(255 255 255 / .3);
}
.input-panel:focus-within { box-shadow: 0 0 0 1px #fff, 0 0 24px rgb(255 255 255 / .25); }
button:focus-visible, a:focus-visible, input:focus-visible, textarea:focus-visible {
  outline-color: #fff;
  box-shadow: 0 0 0 4px rgb(255 255 255 / .2);
}

/* Hero and brand panels */
.landing-hero h1 em {
  color: #fff;
  text-shadow: 0 0 18px rgb(255 255 255 / .75), 0 0 42px rgb(255 255 255 / .35);
}
.hero-preview { box-shadow: 0 0 0 1px rgb(255 255 255 / .12), 0 0 48px rgb(255 255 255 / .18); }
.preview-tag { background: #fff; color: #000; box-shadow: 0 0 14px rgb(255 255 255 / .6); }
.landing-final, .auth-aside {
  position: relative;
  overflow: hidden;
  color: #fff;
  border-color: #333;
  background:
    radial-gradient(420px 220px at 85% 0%, rgb(255 255 255 / .2), transparent 65%),
    radial-gradient(360px 220px at 0% 100%, rgb(255 255 255 / .1), transparent 65%),
    #0d0d0d;
  box-shadow: 0 0 44px rgb(255 255 255 / .12);
}
.feature-number, .avatar, .intro-steps li > span { background: #fff; color: #000; box-shadow: 0 0 12px rgb(255 255 255 / .5); }

/* Findings queue */
.queue-item:hover { box-shadow: inset 0 0 0 1px rgb(255 255 255 / .25), 0 0 18px rgb(255 255 255 / .15); position: relative; z-index: 1; }
.queue-item.selected { box-shadow: inset 0 0 0 2px currentColor, 0 0 22px rgb(255 255 255 / .2); position: relative; z-index: 1; }

@media (max-width: 800px) {
  .app-header { margin-top: 6px; }
}

@media (prefers-reduced-motion: reduce) {
  .primary-button, .nav-link.primary, .secondary-button { transition: none; }
  .primary-button:hover:not(:disabled), .nav-link.primary:hover { transform: none; }
}

@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .intro, .hero-preview, .auth-card, .input-panel, .sample-card, .landing-features article,
  .intro-steps li, .account-chip, .app-header { background: #141414; }
}
